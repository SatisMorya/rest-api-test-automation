{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoRest User",
  "type": "object",
  "required": ["id", "name", "email", "gender", "status"],
  "properties": {
    "id": {"type": "integer"},
    "name": {"type": "string"},
    "email": {"type": "string"},
    "gender": {"type": "string", "enum": ["male", "female"]},
    "status": {"type": "string", "enum": ["active", "inactive"]}
  }
}
